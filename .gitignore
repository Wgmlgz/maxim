# Rust build products
/target/

# Original installer and unsplit local voice data. Track only the runtime
# language files and 32 MiB VOX parts needed for a ready-to-use clone.
/sources/
/extracted/*
!/extracted/app/
/extracted/app/*
!/extracted/app/vox/
!/extracted/app/x64/
/extracted/app/vox/*
!/extracted/app/vox/lang_ru_ru.dat
!/extracted/app/vox/vox_ru_maxim22i.parts
!/extracted/app/vox/vox_ru_maxim22i.unitidx
!/extracted/app/vox/vox_ru_maxim22i.part[0-9][0-9][0-9]
/extracted/app/x64/*
!/extracted/app/x64/voice_ru_maxim.dll

# Local recordings, comparisons, and reverse-engineering artifacts
/samples/
/analysis/
/comparison/
*.wav
*.mp3
*.mdu
*.snapshot.json

# Python and OS-generated files
__pycache__/
*.py[cod]
.DS_Store
